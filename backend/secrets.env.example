# Copy this file to backend/secrets.env (which git ignores) and fill in the real values
# These values tell the server how to reach the secrets store

# NOTE: Do NOT commit secrets.env !!!

SECRETS_MONGO_URI=mongodb://root:localdevpassword@localhost:27017/?authSource=admin
SECRETS_DB=secrets
SECRETS_COLLECTION=env_files
SECRETS_ENV=dev
